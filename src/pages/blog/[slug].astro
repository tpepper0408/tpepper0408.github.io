---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { calculateReadingTime } from '../../utils/readingTime.ts';
import { toBlogSlug } from '../../utils/blog.ts';

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  return blogEntries.map((entry) => ({
    params: { slug: toBlogSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const readingTime = calculateReadingTime(entry.body ?? '');
---

<BlogPost frontmatter={entry.data} readingTime={readingTime}>
  <Content />
</BlogPost>
